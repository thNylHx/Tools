#!name=网易云音乐
#!desc=网易云音乐全面净化，可自定义界面样式。
#!author=Yu9191[https://github.com/Yu9191]
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/NeteaseMusic.png
#!openUrl=https://apps.apple.com/app/id590338362
#!category=去广告, 解锁会员
#!loon_version=3.5.3(1014)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-11-25 20:00
#!arguments=FX:false,MY:true,DT:true,GZ:true,SOU:true,SY_NAME:"",WD_NAME:"",MY_NAME:"",DT_NAME:"",FX_NAME:"",XD:true,YY:false,BK:false,TS:false,HDTAB:false,PRGG:false,PRDRD:true,PRSCVPT:true,PRST:false,HMPR:false,PRRR:true,PRRK:true,PRMST:true,PRCN:true,PRPRS:false,PRRSS:false,LogLevel:"info",Music163_VIP_Shared:#,Cookie:"",MConfigInfo:"",UserAgent:""
#!arguments-desc=FX: 底部-发现\ntrue为隐藏, false为显示\n可选值: false, true\n\nMY: 底部-漫游\ntrue为隐藏, false为显示\n可选值: true, false\n\nDT: 底部-笔记\ntrue为隐藏, false为显示\n可选值: true, false\n\nGZ: 底部-关注\ntrue为隐藏, false为显示\n可选值: true, false\n\nSOU: 底部-搜索\ntrue为隐藏, false为显示\n可选值: true, false\n\nSY_NAME: 底部-首页名称\n自定义名称，留空则保持原名，填写则替换显示\n\nWD_NAME: 底部-我的名称\n自定义名称，留空则保持原名，填写则替换显示\n\nMY_NAME: 底部-漫游名称\n自定义名称，留空则保持原名，填写则替换显示\n\nDT_NAME: 底部-笔记名称\n自定义名称，留空则保持原名，填写则替换显示\n\nFX_NAME: 底部-发现名称\n自定义名称，留空则保持原名，填写则替换显示\n\nXD: 顶部-心动\nfalse为隐藏, true为显示\n可选值: true, false\n\nYY: 顶部-音乐\nfalse为隐藏, true为显示\n可选值: false, true\n\nBK: 顶部-播客\nfalse为隐藏, true为显示\n可选值: false, true\n\nTS: 顶部-听书\nfalse为隐藏, true为显示\n可选值: false, true\n\nHDTAB: 顶部-活动Tab\nfalse为隐藏, true为显示\n可选值: false, true\n\nPRGG: 首页-问候语\nfalse为隐藏, true为显示\n可选值: false, true\n\nPRDRD: 首页-每日推荐\nfalse为隐藏, true为显示\n可选值: true, false\n\nPRSCVPT: 首页-推荐歌单\nfalse为隐藏, true为显示\n可选值: true, false\n\nPRST: 首页-最近常听\nfalse为隐藏, true为显示\n可选值: false, true\n\nHMPR: 首页-音乐合伙人\nfalse为隐藏, true为显示\n可选值: false, true\n\nPRRR: 首页-雷达歌单\nfalse为隐藏, true为显示\n可选值: true, false\n\nPRRK: 首页-排行榜\nfalse为隐藏, true为显示\n可选值: true, false\n\nPRMST: 首页-推荐专属歌单\nfalse为隐藏, true为显示\n可选值: true, false\n\nPRCN: 首页-你的专属歌单\nfalse为隐藏, true为显示\n可选值: true, false\n\nPRPRS: 首页-私房推荐歌曲\nfalse为隐藏, true为显示\n可选值: false, true\n\nPRRSS: 首页-红心相似歌曲\nfalse为隐藏, true为显示\n可选值: false, true\n\nLogLevel: 调试-日志级别\n排错时切到debug可看到Settings/handler内部日志\n可选值: info, off, error, warn, debug, all\n\nMusic163_VIP_Shared: 启用[共享会员]\n是否启用网易云音乐共享会员\n可选值: 留空启用, # 禁用\n\nCookie: Cookie\n请填写Cookie值\n\nMConfigInfo: MConfigInfo\n请填写MConfigInfo值\n\nUserAgent: UserAgent\n请填写UserAgent值

[Rule]
DOMAIN,iadmat.nosdn.127.net,REJECT
DOMAIN,iadmatapk.nosdn.127.net,REJECT
DOMAIN,iadmusicmat.music.126.net,REJECT
DOMAIN,iadmusicmatvideo.music.126.net,REJECT

[Map Local]
(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163.com\/x?e?api\/ad data-type=text data="{}" status-code=200 header="Content-Type:text/plain"

(?i)^https?:\/\/interface\d?\.music\.163\.com\/x?eapi\/(?:resource\/comments?\/musiciansaid|community\/friends\/fans-group\/artist\/group\/get|user\/sub\/artist|music\/songshare\/text\/recommend\/get|mine\/applet\/redpoint|resniche\/position\/play\/new\/get) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https?:\/\/interface\d?\.music\.163.com\/[wx]?e?api\/search\/default data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https?:\/\/interface\d?\.music\.163.com\/[wx]?e?api\/(?:search\/(chart|rcmd\/keyword|specialkeyword)|resource-exposure\/|activity\/bonus\/playpage\/time\/query) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https?:\/\/interface\d?\.music\.163.com\/x?eapi\/(?:mlivestream\/entrance\/playpage|link\/(position\/show\/strategy|scene\/show)|ios\/version|v\d\/content\/exposure\/comment\/banner) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https?:\/\/interface\d?\.music\.163\.com\/store\/x?e?api\/(webconfig|entryconfig) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
{{{Music163_VIP_Shared}}}[网易云音乐]播放会员歌曲 = type=http-request, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/(?:v1\/artist\/top\/song|v3\/discovery\/recommend\/songs), script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusic.vip.js, argument=Cookie="{{{Cookie}}}"&MConfigInfo="{{{MConfigInfo}}}"&UserAgent="{{{UserAgent}}}"

{{{Music163_VIP_Shared}}}[网易云音乐]播放会员歌曲 = type=http-request, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/v3\/song\/detail, script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusic.vip.js, argument=Cookie="{{{Cookie}}}"&MConfigInfo="{{{MConfigInfo}}}"&UserAgent="{{{UserAgent}}}"

{{{Music163_VIP_Shared}}}[网易云音乐]播放会员歌曲 = type=http-request, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/song\/(?:chorus|enhance\/|play\/|type\/detail\/get), script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusic.vip.js, argument=Cookie="{{{Cookie}}}"&MConfigInfo="{{{MConfigInfo}}}"&UserAgent="{{{UserAgent}}}"

{{{Music163_VIP_Shared}}}[网易云音乐]播放器会员皮肤 = type=http-request, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/playermode\/, script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusic.vip.js, argument=Cookie="{{{Cookie}}}"&MConfigInfo="{{{MConfigInfo}}}"&UserAgent="{{{UserAgent}}}"

{{{Music163_VIP_Shared}}}[网易云音乐]搜索结果会员歌曲 = type=http-request, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/search\/(?:complex\/page|complex\/rec\/song\/get|song\/list\/page), script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusic.vip.js, argument=Cookie="{{{Cookie}}}"&MConfigInfo="{{{MConfigInfo}}}"&UserAgent="{{{UserAgent}}}"

{{{Music163_VIP_Shared}}}[网易云音乐]侧边栏会员等级 = type=http-request, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/vipnewcenter\/app\/resource\/newaccountpage, script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusic.vip.js, argument=Cookie="{{{Cookie}}}"&MConfigInfo="{{{MConfigInfo}}}"&UserAgent="{{{UserAgent}}}"

{{{Music163_VIP_Shared}}}[网易云音乐]歌单列表会员认证 = type=http-request, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/w?e?api\/(?:homepage\/|v6\/)?playlist\/(?!(?:delete|subscribe|unsubscribe)), script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusic.vip.js, argument=Cookie="{{{Cookie}}}"&MConfigInfo="{{{MConfigInfo}}}"&UserAgent="{{{UserAgent}}}"

{{{Music163_VIP_Shared}}}[网易云音乐]会员认证 = type=http-request, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/vipauth\/app\/auth\/(soundquality\/)?query, script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusic.vip.js, argument=Cookie="{{{Cookie}}}"&MConfigInfo="{{{MConfigInfo}}}"&UserAgent="{{{UserAgent}}}"

[网易云音乐]通用广告 = type=http-response, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/(batch|v\d\/resource\/comment\/floor\/get|v1\/user\/info|resource\/comments\/reply\/preload|comment\/feed\/inserted\/resources\/combined), script-path=https://raw.githubusercontent.com/Yu9191/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20

[网易云音乐]免流推广弹窗 = type=http-response, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/sp\/flow\/popup\/query, script-path=https://raw.githubusercontent.com/Yu9191/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20

[网易云音乐]底部Tab = type=http-response, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/home\/framework\/tab, script-path=https://raw.githubusercontent.com/Yu9191/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20, argument=FX="{{{FX}}}"&MY="{{{MY}}}"&DT="{{{DT}}}"&GZ="{{{GZ}}}"&SOU="{{{SOU}}}"&SY_NAME="{{{SY_NAME}}}"&WD_NAME="{{{WD_NAME}}}"&MY_NAME="{{{MY_NAME}}}"&DT_NAME="{{{DT_NAME}}}"&FX_NAME="{{{FX_NAME}}}"

[网易云音乐]顶部Tab = type=http-response, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/home\/framework\/top\/tab, script-path=https://raw.githubusercontent.com/Yu9191/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20, argument=XD="{{{XD}}}"&YY="{{{YY}}}"&BK="{{{BK}}}"&TS="{{{TS}}}"&HDTAB="{{{HDTAB}}}"

[网易云音乐]收银台广告 = type=http-response, pattern=(?i)^https?:\/\/((ipv4|interface\d?)\.)?music\.163\.com\/x?e?api\/vipactivity\/app\/cashier\/setting\/get, script-path=https://raw.githubusercontent.com/Yu9191/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20

[网易云音乐]首页卡片 = type=http-response, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/(homepage\/block\/page|link\/page\/rcmd\/(resource\/show|block\/resource\/multi\/refresh)), script-path=https://raw.githubusercontent.com/Yu9191/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20, argument=PRGG="{{{PRGG}}}"&PRDRD="{{{PRDRD}}}"&PRSCVPT="{{{PRSCVPT}}}"&PRST="{{{PRST}}}"&HMPR="{{{HMPR}}}"&PRRR="{{{PRRR}}}"&PRRK="{{{PRRK}}}"&PRMST="{{{PRMST}}}"&PRCN="{{{PRCN}}}"&PRPRS="{{{PRPRS}}}"&PRRSS="{{{PRRSS}}}"

[网易云音乐]发现 = type=http-response, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/page\/discovery\/resource\/show, script-path=https://raw.githubusercontent.com/Yu9191/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20

[网易云音乐]我的 = type=http-response, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/position\/show\/resource, script-path=https://raw.githubusercontent.com/Yu9191/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20

[网易云音乐]关注 = type=http-response, pattern=(?i)^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/user\/follow\/users\/mixed\/get, script-path=https://raw.githubusercontent.com/Yu9191/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20

[网易云音乐]去广告设置页 = type=http-request, pattern=(?i)^https?:\/\/music\.163\.com\/wyy-settings, script-path=https://raw.githubusercontent.com/Yu9191/NeteasemusicAd/main/wyyad.js, timeout=20

[MITM]
hostname = %APPEND% music.163.com, interface.music.163.com, interface3.music.163.com, interface9.music.163.com, httpdns.n.netease.com, ipv4.music.163.com

