[Header Rewrite]
http-request (?i)^https?:\/\/[^\/:?#]*\.live-video\.net[^\/:?#]*(?=[:\/?#]|$) header-del "Origin"
http-request (?i)^https?:\/\/[^\/:?#]*\.live-video\.net[^\/:?#]*(?=[:\/?#]|$) header-add "Origin" "https://www.pandalive.co.kr"

[MITM]
hostname = %APPEND% live-video.net, *.live-video.net

