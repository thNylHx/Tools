[Script]
[拼多多]精简评价页 = type=http-response, pattern=(?i)^https:\/\/m\.pinduoduo\.net\/comment_result\.html\?, script-path=https://rucu6.pages.dev/Scripts/pinduoduo.js, requires-body=true

[拼多多]精简取件页 = type=http-response, pattern=(?i)^https:\/\/m\.pinduoduo\.net\/mdkd\/package\?, script-path=https://rucu6.pages.dev/Scripts/pinduoduo.js, requires-body=true

[MITM]
hostname = %APPEND% api.pinduoduo.com, api.yangkeduo.com, m.pinduoduo.net

