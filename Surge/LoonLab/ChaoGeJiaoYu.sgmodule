[Body Rewrite]
http-response-jq (?i)^https:\/\/mapi\.chaogejiaoyu\.com\/api\/user\/checkToken(?:\?|$) '.data.has_ad_page_list = [] | .data.startup.show_promotion = 0 | .data.startup.promotion_url = "" | .data.startup.home_top_menu_list |= map(select(.type != "ad_btn"))'

[Map Local]
(?i)^https:\/\/mapi\.chaogejiaoyu\.com\/api\/ad\/getPageAdList(?:\?|$) data-type=text data="{\"status\":0,\"message\":\"success\",\"data\":{\"ad_list\":[]}}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/mapi\.chaogejiaoyu\.com\/api\/outline\/getAppBanner\?(?:[^#]*&)?adv_flag=1(?:&|$) data-type=text data="{\"status\":0,\"message\":\"success\",\"data\":[]}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/mapi\.chaogejiaoyu\.com\/api\/course\/getOpenCourseColumnInfo(?:\?|$) data-type=text data="{\"status\":0,\"message\":\"success\",\"data\":{}}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% mapi.chaogejiaoyu.com

