(?i)^https:\/\/bd-api\.kuwo\.cn\/api\/service\/home\/module\?.*&moduleId=6 data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/bd-api\.kuwo\.cn\/api\/advert\/earning\/app\/config\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

