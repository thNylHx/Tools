#!name=京东
#!desc=1.过滤京东广告；2.历史比价信息，任选其一即可。（首次使用请先打开【慢慢买App-我的】，提示【获取ck成功🎉】即可正常比价。）\n此插件仅支持京东标准模式。
#!author=RuCu6[https://github.com/RuCu6], Maasea[https://github.com/Maasea], MuTu[https://github.com/githubdulong], 苍井灰灰[https://github.com/wf021325], mw418[https://github.com/mw418], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/JingDong.png
#!openUrl=https://apps.apple.com/app/id414245413
#!category=去广告, 功能增强
#!loon_version=3.5.3(1014)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-11-02 21:00
#!arguments=Manmanbuy-Cookie:"",JDPrice-TitleEmbed:#,JDPrice-DetailNotify:#,JDPrice-DetailEmbed-Table:"",JDPrice-DetailEmbed-Line:#
#!arguments-desc=Manmanbuy-Cookie: [京东比价]获取慢慢买Cookie\n首次使用请先打开【慢慢买】APP，提示【获取ck成功🎉】即可正常比价。\n可选值: 留空启用, # 禁用\n\nJDPrice-TitleEmbed: [京东比价]标题嵌入版\n点击商品标题即可直接查看嵌入式历史价格\n可选值: 留空启用, # 禁用\n\nJDPrice-DetailNotify: [京东比价]详情通知版\n点击商品详情页通过弹窗通知查看历史价格\n可选值: 留空启用, # 禁用\n\nJDPrice-DetailEmbed-Table: [京东比价]详情嵌入版（表格图）\n点击商品详情页即可直接查看嵌入式历史价格\n可选值: 留空启用, # 禁用\n\nJDPrice-DetailEmbed-Line: [京东比价]详情嵌入版（折线图）\n点击商品详情页即可直接查看嵌入式历史价格\n可选值: 留空启用, # 禁用

[Rule]
URL-REGEX,"^http:\/\/\w{32}\.jddebug\.com\/diagnose\?",REJECT

[Body Rewrite]
http-response (?i)^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=lite_advertising "jdLiteAdvertisingVO" "sooyaaabo"
http-response-jq (?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=basicConfig 'if ((getpath(["data","JDMessage","socketmonitor"]) // {}) | has("isSocketEstablishedAhead")) then (setpath(["data","JDMessage","socketmonitor","isSocketEstablishedAhead"]; 0)) else . end'
http-response-jq (?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=basicConfig 'if ((getpath(["data","JDMessage","socketmonitor"]) // {}) | has("isSocketReport")) then (setpath(["data","JDMessage","socketmonitor","isSocketReport"]; 0)) else . end'
http-response-jq (?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=basicConfig 'if ((getpath(["data","JDHttpToolKit","httpdns"]) // {}) | has("httpdns")) then (setpath(["data","JDHttpToolKit","httpdns","httpdns"]; 0)) else . end'
http-response-jq (?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=cart 'delpaths([["cartLocationMap","loc_emptyCartFloor2"]])'
http-response-jq (?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=cart 'delpaths([["emptyCartRecommendFloor"]])'

[Map Local]
(?i)^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2436_jfs data-type=text data="" status-code=200

(?i)^https?:\/\/api\.m\.jd\.com\/\?(?:[^#?&]+&)*loginType=11 data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=getWidgetV1052 data-type=text data="" status-code=404

(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=(?:cartCouponRecommendGoods|intelligentRecommendSku|obtainGrowingInfo|recommendShop|searchBoxWord|stationPullService|uniformRecommend) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
[京东]移除广告 = type=http-response, pattern=(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=(?:deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome), script-path=https://rucu6.pages.dev/Scripts/jingdong.js, requires-body=true

[京东]移除京东极速版广告 = type=http-response, pattern=(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=lite_advertising, script-path=https://loon.103516.xyz/Script/CommonScript/replace-body.js, requires-body=true, argument="jdLiteAdvertisingVO -> sooyaaabo"

{{{Manmanbuy-Cookie}}}[京东比价]获取慢慢买Cookie = type=http-request, pattern=(?i)^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$, script-path=https://raw.githubusercontent.com/mw418/Loon/main/script/jd_price.js, requires-body=true, timeout=60

{{{JDPrice-TitleEmbed}}}[京东比价]标题嵌入版 = type=http-response, pattern=(?i)^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=(wareBusiness|serverConfig|basicConfig), script-path=https://raw.githubusercontent.com/wf021325/qx/master/js/jd_price.js, requires-body=true

{{{JDPrice-DetailNotify}}}[京东比价]详情通知版 = type=http-request, pattern=(?i)^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://raw.githubusercontent.com/mw418/Loon/main/script/jd_price.js, timeout=60

{{{JDPrice-DetailEmbed-Table}}}[京东比价]详情嵌入版（表格图） = type=http-response, pattern=(?i)^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://raw.githubusercontent.com/wf021325/qx/master/js/jd_price.js, requires-body=true, timeout=60

{{{JDPrice-DetailEmbed-Line}}}[京东比价]详情嵌入版（折线图） = type=http-response, pattern=(?i)^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://loon.103516.xyz/Script/JingDong/JingDong.price.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% api.m.jd.com, in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com, m.360buyimg.com

