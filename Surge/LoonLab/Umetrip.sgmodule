#!name=航旅纵横
#!desc=过滤航旅纵横广告
#!author=xingjiu29[https://github.com/xingjiu29]
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Umetrip.png
#!openUrl=https://apps.apple.com/app/id480161784
#!category=去广告
#!loon_version=3.5.3(1014)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-11-05 23:00

[Rule]
DOMAIN,sensors.umetrip.com.cn,REJECT
DOMAIN,analytics.umetrip.com,REJECT

[Map Local]
(?i)^https?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native data-type=text data="" status-code=404

(?i)^https?:\/\/oss\.umetrip\.com\/fs\/advert\/polite data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
[纵横航旅]移除广告 = type=http-response, pattern=(?i)^https?:\/\/(bkclient|umerp|home|umehome|sns|appmsg)\.umetrip\.com(\.cn)?\/gateway\/api\/umetrip\/native(?:\?.*)?$, script-path=https://raw.githubusercontent.com/xingjiu29/Umetrip/main/umetrip.js, requires-body=true, binary-body-mode=true, timeout=30

[MITM]
hostname = %APPEND% umerp.umetrip.com, umerp.umetrip.com.cn, home.umetrip.com, bkclient.umetrip.com.cn, discardrp.umetrip.com, startup.umetrip.com, oss.umetrip.com, umehome.umetrip.com, sns.umetrip.com, appmsg.umetrip.com

