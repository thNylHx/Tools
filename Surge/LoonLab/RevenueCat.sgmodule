#!name=RevenueCat
#!desc=RevenueCat系列解锁合集，在设置中选择需要使用的原作者脚本以使用此插件。
#!author=chxm1023[https://github.com/chxm1023], ddgksf2013[https://github.com/ddgksf2013], Guding88[https://github.com/Guding88]
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/RevenueCat.png
#!category=解锁会员
#!loon_version=3.5.3(1014)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-11-02 21:00
#!arguments=RevenueCat-chxm1023:#,RevenueCat-Guding88:#,RevenueCat-ddgksf2013:#
#!arguments-desc=RevenueCat-chxm1023: RevenueCat-chxm1023\n是否启用chxm1023的脚本来解锁RevenueCat系列\n可选值: 留空启用, # 禁用\n\nRevenueCat-Guding88: RevenueCat-Guding88\n是否启用Guding88的脚本来解锁RevenueCat系列\n可选值: 留空启用, # 禁用\n\nRevenueCat-ddgksf2013: RevenueCat-ddgksf2013\n是否启用ddgksf2013的脚本来解锁RevenueCat系列\n可选值: 留空启用, # 禁用

[Map Local]
(?i)^https:\/\/api\.lianjiu\.fun\/app\/api\/v1\/profile data-type=text data="" status-code=404

[Script]
{{{RevenueCat-chxm1023}}}[RevenueCat]会员Crack响应@chxm1023 = type=http-response, pattern=(?i)^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$), script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/Reheji.js, requires-body=true

{{{RevenueCat-chxm1023}}}[RevenueCat]会员Crack请求@chxm1023 = type=http-request, pattern=(?i)^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$), script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/Reheji.js

{{{RevenueCat-Guding88}}}[RevenueCat]会员Crack响应@Guding88 = type=http-response, pattern=(?i)^https?:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(subscribers\/[^\/]+$|receipts$), script-path=https://raw.githubusercontent.com/Guding88/Script/main/APPheji_Revenuecat.js, requires-body=true

{{{RevenueCat-Guding88}}}[RevenueCat]会员Crack请求@Guding88 = type=http-request, pattern=(?i)^https?:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(subscribers\/[^\/]+$|receipts$), script-path=https://raw.githubusercontent.com/Guding88/Script/main/APPheji_Revenuecat.js

{{{RevenueCat-ddgksf2013}}}[RevenueCat]会员Crack响应@ddgksf2013 = type=http-response, pattern=(?i)^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$), script-path=https://ddgksf2013.top/scripts/revenuecat.vip.js, requires-body=true

{{{RevenueCat-ddgksf2013}}}[RevenueCat]会员Crack请求@ddgksf2013 = type=http-request, pattern=(?i)^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$), script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/deleteHeader.js

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, api.lianjiu.fun

