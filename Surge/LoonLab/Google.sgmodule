#!name=Google
#!desc=将Google搜索重定向至.com域名，如遇频繁跳转请禁用本插件。
#!author=sooyaaabo[https://github.com/sooyaaabo]
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Google.png
#!openUrl=https://apps.apple.com/app/id284815942
#!category=功能增强
#!loon_version=3.5.3(1014)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-11-02 21:00

[URL Rewrite]
(?i)^https?:\/\/(www\.)?(?:g|google)\.cn https://www.google.com 307
(?i)^https?:\/\/(?:ditu|maps).google\.cn https://maps.google.com 307
(?i)^https?:\/\/translate\.google\.cn https://translate.google.com 307

[MITM]
hostname = %APPEND% *.google.cn, *.g.cn

