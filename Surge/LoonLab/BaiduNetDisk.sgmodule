#!name=百度网盘
#!desc=过滤百度网盘广告，解锁部分SVIP功能。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], ddgksf2013[https://github.com/ddgksf2013], chxm1023[https://github.com/chxm1023]
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/BaiduNetDisk.png
#!openUrl=https://apps.apple.com/app/id547166701
#!category=去广告, 解锁会员
#!loon_version=3.5.3(1014)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-11-02 21:00

[Body Rewrite]
http-response-jq (?i)^https:\/\/pan\.baidu\.com\/feed\/kingkongdistrict\? '.data.data |= map(select(.type != "novel" and .type != "shortplay" and .type != "print" and .type != "job_hunt"))'

[Map Local]
(?i)^https:\/\/pan\.baidu\.com\/api\/getconfig\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/pan\.baidu\.com\/api\/getsyscfg\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/pan\.baidu\.com\/api\/taskscore\/tasklist\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/pan\.baidu\.com\/act\/api\/activityentry\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/pan\.baidu\.com\/rest\/\d\.\d\/pcs\/adv\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/pan\.baidu\.com\/api\/plugin\/get\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/pan\.baidu\.com\/recommend\/query\/list\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https?:\/\/.*baidu\.com\/rest\/.*\/membership\/proxy\/guide data-type=text data="" status-code=200

(?i)^https?:\/\/pan\.baidu\.com\/act\/v\d\/(bchannel|welfare)\/list data-type=text data="" status-code=200

(?i)^https:\/\/pan\.baidu\.com\/feed\/hotlist data-type=text data="" status-code=200

(?i)^https?:\/\/.*zhangyuyidong\.cn\/api\/zysdk data-type=text data="" status-code=200

(?i)^https:\/\/pan\.baidu\.com\/queryintent\/queryhint data-type=text data="" status-code=200

(?i)^https:\/\/pan\.baidu\.com\/coins\/center\/notice data-type=text data="" status-code=200

(?i)^https:\/\/pan\.baidu\.com\/recommend\/shortseries\/list data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
[百度网盘]移除广告推广 = type=http-response, pattern=(?i)^https?:\/\/afd\.baidu\.com\/afd\/entry, script-path=https://ddgksf2013.top/scripts/bdpan.ads.js, requires-body=true

[百度网盘]移除首页信息流广告 = type=http-response, pattern=(?i)^https:\/\/pan\.baidu\.com\/feed\/cardinfos, script-path=https://ddgksf2013.top/scripts/bdpan.ads.js, requires-body=true

[百度网盘]移除游戏广告 = type=http-response, pattern=(?i)^https:\/\/pan\.baidu\.com\/rest\/.*\/membership\/user\?(?:[^#?&]+&)*method=gamecenter, script-path=https://ddgksf2013.top/scripts/bdpan.ads.js, requires-body=true

[百度网盘]会员权益@chxm1023 = type=http-response, pattern=(?i)^https?:\/\/pan\.baidu\.com\/(act\/.+\/(activityentry|bchannel|cardwelfare|skin)|rest\/.+\/(membership\/user|pcs\/adv)|feed\/cardinfos|api\/(user\/getinfo|quota|loginstatus|account\/getprivilege)|buy\/ad\/conf|wap\/vip|coins\/taskcenter\/homensr), script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/bdcloud.js, requires-body=true

[百度网盘]倍速播放@ddgksf2013 = type=http-request, pattern=(?i)^https:\/\/pan\.baidu\.com\/api\/streaming\?(?:[^#?&]+&)*app_id=\d+&type=M3U8_HQ_1080, script-path=https://ddgksf2013.top/scripts/bdpan.unlock.js

[百度网盘]倍速播放@ddgksf2013 = type=http-response, pattern=(?i)^https:\/\/pan\.baidu\.com\/rest\/.*\/membership\/user, script-path=https://ddgksf2013.top/scripts/bdpan.unlock.js, requires-body=true

[MITM]
hostname = %APPEND% pan.baidu.com, afd.baidu.com

