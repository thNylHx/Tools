#!name=微博
#!desc=微博全面净化
#!author=RuCu6[https://github.com/RuCu6], fmz200[https://github.com/fmz200], zmqcherish[https://github.com/zmqcherish], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/WeiBo.png
#!openUrl=https://apps.apple.com/app/id350962117
#!category=去广告
#!loon_version=3.5.3(1014)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-11-02 21:00
#!arguments=MainTabFilter:""
#!arguments-desc=MainTabFilter: 顶部 Tab 过滤\n顶部 Tab 过滤\n可选值: 留空启用, # 禁用

[Rule]
URL-REGEX,"^https?:\/\/m?api\.weibo\.c(n|om)\/2\/(push\/active|client\/addlog_batch|ad\/preload)",REJECT-DROP
URL-REGEX,"^https?:\/\/api-cloudim\.api\.weibo\.com\/v1\/log\/",REJECT-DROP
DOMAIN-SUFFIX,alitui.weibo.com,REJECT
DOMAIN-SUFFIX,beacon.sina.com.cn,REJECT
DOMAIN-SUFFIX,biz.weibo.com,REJECT
DOMAIN,dns.weibo.cn,REJECT
DOMAIN,huodong.weibo.cn,REJECT
DOMAIN,sax.sina.com.cn,REJECT
DOMAIN,saxn.sina.com.cn,REJECT
DOMAIN,saxs.sina.com.cn,REJECT
DOMAIN,u1.img.mobile.sina.cn,REJECT
DOMAIN,bootpreload.uve.weibo.com,REJECT
DOMAIN-SUFFIX,fastimage.uve.weibo.com,REJECT
DOMAIN-SUFFIX,adimg.vue.weibo.com,REJECT
DOMAIN-SUFFIX,zymo.mps.weibo.com,REJECT
DOMAIN-SUFFIX,weibomingzi.com,REJECT
DOMAIN-SUFFIX,sdkapp.uve.weibo.com,REJECT
DOMAIN-SUFFIX,promote.biz.weibo.cn,REJECT
DOMAIN-SUFFIX,gw5.push.mcp.weibo.cn,REJECT
DOMAIN-SUFFIX,gw6.push.mcp.weibo.cn,REJECT
DOMAIN-SUFFIX,game.weibo.cn,REJECT
DOMAIN-SUFFIX,adimg.uve.weibo.com,REJECT
DOMAIN-SUFFIX,game.weibo.com,REJECT
DOMAIN-SUFFIX,ads.viber.com,REJECT
DOMAIN-SUFFIX,ads-d.viber.com,REJECT
DOMAIN-SUFFIX,ads.aws.viber.com,REJECT
DOMAIN-SUFFIX,dp.im.weibo.cn,REJECT
DOMAIN-SUFFIX,click.uve.weibo.com,REJECT
DOMAIN-SUFFIX,wax.weibo.com,REJECT
DOMAIN-SUFFIX,wbapp.uve.weibo.com,REJECT
DOMAIN-SUFFIX,widget.weibo.com,REJECT
DOMAIN-SUFFIX,dsp.edm.weibo.cn,REJECT
DOMAIN-SUFFIX,alitui.weibo.com.cn,REJECT
DOMAIN-SUFFIX,tui.weibo.com,REJECT
DOMAIN-SUFFIX,wax.weibo.com.cn,REJECT
DOMAIN-SUFFIX,ad.weibo.com,REJECT
DOMAIN,datacollection.uve.weibo.com,REJECT
DOMAIN,adpinpai.video.weibocdn.com,REJECT

[Body Rewrite]
http-response-jq (?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/cardlist\? 'del(.items[] | select(.category == "group"))'

[Map Local]
(?i)^https?:\/\/m?api\.weibo\.c(n|om)\/2\/logservice\/service\? data-type=text data="" status-code=404

(?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/(?:ug\/checkin\/list|push\/daily|push\/info) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/!\/live\/media_homelist\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/comments\/bullet_screens\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/photo\/info\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/statuses\/(?:container_positive|push_info) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/vote\/get_vote_detail\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/!\/chaohua\/discovery\/home_bottom\/switch\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/!\/huati\/(?:discovery_home_bottom_channels|discovery_home_bottom_getdotinfo|mobile_discovery_searchchange) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/!\/wbox\/\w+\/(?:home_bottom_modal|interest_category) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/search\/(?:container_discover|finder_nav_polling)\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/hot\/hours_spotlight\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/video\/redpacket\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/!\/(?:search\/finder_nav_polling|sug\/list\/finderchange|was\/finder\/searchbarchange)\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/video\/tiny_video_info_show\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/(?:bootrealtime|bootpreload)\.uve\.weibo\.com\/v\d\/ad\/(?:realtime|preload) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(?:get-lbs-cell-info\.php|sdkconfig\.php) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/card\.weibo\.com\/article\/m\/aj\/(?:reward|uvead) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/weibo\.com\/ttarticle\/x\/m\/aj\/(?:reward|uvead) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
{{{MainTabFilter}}}[微博]顶部Tab页分组 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.c(n|om)\/2\/groups\/allgroups\/v2\?, script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/weibo/weibo_ads.js, requires-body=true, timeout=60

[微博]移除首页推广 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/(?:checkin\/show|client\/publisher_list|push\/active), script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除首页顶部标签 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/groups\/allgroups\/v2\?, script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除信息流广告 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/(?:cardlist|page), script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除评论区广告 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/comments\/build_comments\?, script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除个人微博详情页广告 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/(?:container\/asyn|flowlist|flowpage), script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除关注、取消关注弹窗 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/friendships\/(?:create|destroy), script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除个人主页广告 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/profile\/(?:container_timeline|dealatt|me|statuses\/tab|userinfo), script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除超话搜索页广告 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/shproxy\/chaohua\/discovery\/searchactive\?, script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除评论区广告 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/statuses\/(?:comments_expand_child|container_detail_comment), script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除信息流广告 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/statuses\/(?:container_detail\?|container_timeline(?:_hot|_topic|_topicpage|_unread)?|repost_timeline|unread_hot_timeline), script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除微博详情页广告 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/statuses\/(?:extend|show)\?, script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除视频流广告 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/video\/(?:full_screen_stream|tiny_stream_mid_detail|tiny_stream_video_list)\?, script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除超话顶部标签 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/!\/huati\/discovery_home_bottom_channels\?, script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除消息页列表广告 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/direct_messages\/user_list\?, script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除消息页提醒 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/messageflow\/notice\?, script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除发现页广告 = type=http-response, pattern=(?i)^https?:\/\/m?api\.weibo\.c(n|om)\/2\/search\/(?:finder|container_timeline|container_discover)\?, script-path=https://loon.103516.xyz/Script/WeiBo/WeiBo.ads.js, requires-body=true

[微博]移除发现页搜索结果广告 = type=http-response, pattern=(?i)^https:\/\/m?api\.weibo\.cn\/2\/searchall\?, script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除开屏广告 preload = type=http-response, pattern=(?i)^https:\/\/bootpreload\.uve\.weibo\.com\/v[12]\/ad\/preload, script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除开屏广告 sdkad = type=http-response, pattern=(?i)^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php, script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]移除开屏广告 wbapplua = type=http-response, pattern=(?i)^https:\/\/wbapp\.uve\.weibo\.com\/(?:preload\/get_ad|wbapplua\/wbpullad\.lua), script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[微博]会员图标 = type=http-response, pattern=(?i)^https:\/\/new\.vip\.weibo\.cn\/aj\/appicon\/list\?, script-path=https://rucu6.pages.dev/Scripts/weibo.js, requires-body=true

[MITM]
hostname = %APPEND% *.weibo.cn, *.weibo.com, weibo.com

