#!name=中国联通
#!desc=过滤中国联通广告
#!author=mist-whisper[https://github.com/mist-whisper]
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/ChinaUnicom.png
#!openUrl=https://apps.apple.com/app/id416457422
#!category=去广告
#!loon_version=3.5.3(1014)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-11-02 21:00

[Rule]
DOMAIN,m1.ad.10010.com,REJECT

[Body Rewrite]
http-response-jq (?i)^https:\/\/m\.client\.10010\.com\/search_service\/tyfbSearch\/searchDiscoverListExpress '.data = []'
http-response-jq (?i)^https:\/\/m\.client\.10010\.com\/search_service\/search\/searchScrollWord '.["113000004"] = []'
http-response-jq (?i)^https:\/\/m\.client\.10010\.com\/clientIndex\/v1\/api\/navHome '.datas.homeTopMenuItems |= map(select(.menuName != "通通" and .menuName != "vowifi" and .menuName != "签到" and .menuName != ""))'
http-response-jq (?i)^https:\/\/m\.client\.10010\.com\/clientIndex\/homefusion\/fuInter 'del(.["HomeFusion.backGroundQuery"], .["HomeFusion.fuchuangAdv_A8"], .["HomeFusion.bottomLabel"])'
http-response-jq (?i)^https:\/\/m\.client\.10010\.com\/clientMyPage\/v1\/api\/myWallet '.data.payShowFlag = false'
http-response-jq (?i)^https?:\/\/m\.client\.10010\.com\/clientMyPage\/v\d\/api\/(myWallet|myPoints|myColorfulRingtone|newUserInfo|getDeviceInfo) '.data={}'

[Map Local]
(?i)^https?:\/\/m\.client\.10010\.com\/mobileserviceimportant\/customer\/querySmartServicekhd.htm data-type=text data="" status-code=404

(?i)^https?:\/\/m\.client\.10010\.com\/clientIndex\/api\/v1\/index\/queryIndexExclusiveOffers data-type=text data="" status-code=404

(?i)^https?:\/\/img\.client\.10010\.com\/homejingxuan12\/js\/(pubuliu|1homeView) data-type=text data="" status-code=404

[MITM]
hostname = %APPEND% m.client.10010.com, img.client.10010.com

