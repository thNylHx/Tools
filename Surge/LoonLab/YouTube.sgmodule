#!name=YouTube (Music)
#!desc=过滤YouTube (Music)广告，增加画中画、字幕翻译、歌词翻译功能，支持后台播放。需要启用QUIC回退保护。不支持tvOS设备。
#!author=Maasea[https://github.com/Maasea], RuCu6[https://github.com/RuCu6]
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/YouTube.png
#!openUrl=https://apps.apple.com/app/id544007664
#!category=去广告, 功能增强
#!system_version=15
#!loon_version=3.5.3(1014)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-11-02 21:00
#!arguments=blockUpload:true,blockShorts:true,blockImmersive:true,captionLang:"off",debug:false
#!arguments-desc=blockUpload: 隐藏上传按钮\n用于隐藏YouTube底栏的上传按钮\n可选值: true, false\n\nblockShorts: 隐藏Shorts按钮\n用于隐藏YouTube底栏的Shorts按钮\n可选值: true, false\n\nblockImmersive: 隐藏选段按钮\n用于隐藏YouTube Music底栏的选段按钮\n可选值: true, false\n\ncaptionLang: 字幕翻译语言\n选择翻译为何种语言字幕\n可选值: off, zh-Hans, zh-Hant, ja, ko, en\n\ndebug: 启用调试模式\n此插件的调试模式\n可选值: false, true

[Script]
[YouTube]response = type=http-response, pattern=(?i)^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$, script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js, requires-body=true, binary-body-mode=true, argument=captionLang="{{{captionLang}}}"&blockUpload="{{{blockUpload}}}"&blockImmersive="{{{blockImmersive}}}"&blockShorts="{{{blockShorts}}}"&debug="{{{debug}}}"

[YouTube]request_init = type=http-request, pattern=(?i)^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*, script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js, requires-body=true, binary-body-mode=true, argument=captionLang="{{{captionLang}}}"

[YouTube]request_log_event = type=http-request, pattern=(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event, script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js, requires-body=true, binary-body-mode=true

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com

