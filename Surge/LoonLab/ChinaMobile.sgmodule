#!category=去广告, 功能增强
#!loon_version=3.5.3(1014)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-11-14 23:00
#!arguments=BottomClean:true,SearchPageClean:true,MessageAdClean:true,HomeBasicClean:true,HideTopFamily:false,HideTopAge:false,HideTopPhone:false,HideTopNearby:false,HideTopAI:false,HideTopEnterprise:false,CommunicationAdClean:true,MineClean:true,ServicePageClean:true,HideMyCheckIn:false,HideMyMarketing:false,HideMyServices:false,HideMyFamilyCube:false,HideMyDevicesCube:false,HideMyMiniProgram:false,HideMyDigitalHuman:false,HideMySelections:false,HideMyGroup:false,HideMyRingtone:false,HideMyCloudDrive:false,HideMyToolbox:false,HideMyLifeServices:false,CMCC_Cookie:#
#!arguments-desc=BottomClean: [底栏] 隐藏-AI灵犀\n隐藏底栏AI灵犀入口\n可选值: true, false\n\nSearchPageClean: [搜索] 页面净化\n移除搜索页面广告\n可选值: true, false\n\nMessageAdClean: [消息] 页面净化\n移除消息页面广告\n可选值: true, false\n\nHomeBasicClean: [首页] 基础净化\n移除基础广告\n可选值: true, false\n\nHideTopFamily: [首页] 隐藏-爱家\n隐藏首页顶部Tab-爱家\n可选值: false, true\n\nHideTopAge: [首页] 隐藏-网龄\n隐藏首页顶部Tab-网龄\n可选值: false, true\n\nHideTopPhone: [首页] 隐藏-手机\n隐藏首页顶部Tab-手机\n可选值: false, true\n\nHideTopNearby: [首页] 隐藏-附近厅\n隐藏首页顶部Tab-附近厅\n可选值: false, true\n\nHideTopAI: [首页] 隐藏-AI尝鲜\n隐藏首页顶部Tab-AI尝鲜\n可选值: false, true\n\nHideTopEnterprise: [首页] 隐藏-政企\n隐藏首页顶部Tab-政企\n可选值: false, true\n\nCommunicationAdClean: [通信] 页面净化\n移除通信页面通讯录内广告\n可选值: true, false\n\nMineClean: [我的] 基础净化\n移除基础广告\n可选值: true, false\n\nServicePageClean: [我的] 我的服务-广告净化\n移除我的服务模块中子模块内的广告\n可选值: true, false\n\nHideMyCheckIn: [我的] 隐藏-签到浮窗\n隐藏我的-签到浮窗 areaId 20230721008\n可选值: false, true\n\nHideMyMarketing: [我的] 隐藏-营销区域\n隐藏我的-营销区域 areaId 20230721012\n可选值: false, true\n\nHideMyServices: [我的] 隐藏-我的服务\n隐藏我的-我的服务 areaId 20230721018\n可选值: false, true\n\nHideMyFamilyCube: [我的] 隐藏-我的家庭\n隐藏我的-我的家庭 areaId 20240708002\n可选值: false, true\n\nHideMyDevicesCube: [我的] 隐藏-我的设备\n隐藏我的-我的设备 areaId 20251024002\n可选值: false, true\n\nHideMyMiniProgram: [我的] 隐藏-我的账户\n隐藏我的-我的账户 areaId 20231017002\n可选值: false, true\n\nHideMyDigitalHuman: [我的] 隐藏-AI智能助理\n隐藏我的-AI智能助理 areaId 20230721020\n可选值: false, true\n\nHideMySelections: [我的] 隐藏-我的优选\n隐藏我的-我的优选 areaId 20230721030\n可选值: false, true\n\nHideMyGroup: [我的] 隐藏-我的集团\n隐藏我的-我的集团 areaId 20230721036\n可选值: false, true\n\nHideMyRingtone: [我的] 隐藏-我的彩铃\n隐藏我的-我的彩铃 areaId 20251230002\n可选值: false, true\n\nHideMyCloudDrive: [我的] 隐藏-我的云盘\n隐藏我的-我的云盘 areaId 20240624002\n可选值: false, true\n\nHideMyToolbox: [我的] 隐藏-百宝箱\n隐藏我的-百宝箱 areaId 20230721044\n可选值: false, true\n\nHideMyLifeServices: [我的] 隐藏-生活服务\n隐藏我的-生活服务 areaId 20230928004\n可选值: false, true\n\nCMCC_Cookie: [小组件]获取Cookie\n获取Cookie以使用Scripting小组件\n可选值: 留空启用, # 禁用

[Map Local]
(?i)^https?:\/\/(?:client\.app\.coc|app)\.10086\.cn\/biz-orange\/DN\/(?:explorePage\/getAdverList|init\/startInit|emotionMarket)(?:\?.*)?$ data-type=text data="" status-code=200

(?i)^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:dropsAdverService\/getDropsAdverNew|homepagePopup\/getSortInfo|toast\/getToastRule)|DH\/toast\/august\/getToast|DA\/liveSuspension\/getPageCode)(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
{{{CMCC_Cookie}}}[中国移动]获取Cookie = type=http-request, pattern=(?i)^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/[LD]N\/uam(onekey|randcode)login\/autoLogin, script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/main/app/cmcc/cmcc.js, requires-body=true

{{{CMCC_Cookie}}}[中国移动]获取Cookie = type=http-request, pattern=(?i)^https:\/\/clientaccess\.10086\.cn\/biz-orange\/BN\/scoreQueryService\/getScoreQuery, script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/main/app/cmcc/cmcc.js, requires-body=true

{{{CMCC_Cookie}}}[中国移动]获取Cookie = type=http-request, pattern=(?i)^https:\/\/h5\.bj\.10086\.cn\/ActSignIn2023\/doPrize, script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/main/app/cmcc/cmcc.js

[MITM]
hostname = %APPEND% client.app.coc.10086.cn, h.app.coc.10086.cn, app.10086.cn, touch.10086.cn, ad.mcloud.139.com

