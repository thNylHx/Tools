[Script]
{{{vist}}}[Soul]个人主页数量提示 = type=http-response, pattern=(?i)^https:\/\/api-user\.soulapp\.cn\/user\/homepage\/metrics, script-path=https://raw.githubusercontent.com/ishowshu/qx/main/script/soul.js, requires-body=true

{{{chatPri}}}[Soul]去除私聊限制 = type=http-response, pattern=(?i)^https:\/\/api-chat\.soulapp\.cn\/chat\/limitInfo, script-path=https://raw.githubusercontent.com/ishowshu/qx/main/script/soul.js, requires-body=true

{{{picRead}}}[Soul]私聊阅后即焚 = type=http-response, pattern=(?i)^https:\/\/api-chat\.soulapp\.cn\/snapchat\/url, script-path=https://raw.githubusercontent.com/ishowshu/qx/main/script/soul.js, requires-body=true

[MITM]
hostname = %APPEND% ssp.soulapp.cn, increase-openapi.soulapp.cn, post.soulapp.cn, api-account.soulapp.cn, api-a.soulapp.cn, gateway-mobile-gray.soulapp.cn, api-user.soulapp.cn, chat-live.soulapp.cn, api-chat.soulapp.cn, activity.soulapp.cn, 47.110.187.87, 47.75.72.47, 47.96.7.91, 47.96.11.46, 47.96.20.45, 47.97.215.55, 47.98.54.106, 47.98.137.249, 47.99.42.29, 114.215.255.94, 116.62.28.7, 116.62.47.28, 118.31.7.235, 118.31.112.221, 120.27.235.201, 120.55.55.115, 120.55.62.124, 121.196.197.147, 121.196.203.183

