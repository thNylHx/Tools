[Rule]
DOMAIN,ad.seeyouyima.com,REJECT
DOMAIN,axxd.xmseeyouyima.com,REJECT
DOMAIN,jingqi.youzibuy.com,REJECT
DOMAIN,mgo.seeyouyima.com,REJECT
DOMAIN,ad-logs.seeyouyima.com,REJECT
DOMAIN,circle.seeyouyima.com,REJECT
DOMAIN,ab.seeyouyima.com,REJECT

[Body Rewrite]
http-response-jq (?i)^https?:\/\/sub\.seeyouyima\.com\/v\d\/sub\/my_vip '.data={}'
http-response-jq (?i)^https?:\/\/users\.seeyouyima\.com\/v\d\/wo\? 'del(.data.circle)'

[Map Local]
(?i)^https?:\/\/circle\.(xm)?seeyouyima\.com\/v\d\/article_recommend\? data-type=text data="" status-code=404

(?i)^https?:\/\/common\.seeyouyima\.com\/v\d\/conf_list data-type=text data="" status-code=404

(?i)^https?:\/\/config-service\.seeyouyima\.com\/api\/configs\/batch data-type=text data="" status-code=200

[MITM]
hostname = %APPEND% circle.seeyouyima.com, circle.xmseeyouyima.com, common.seeyouyima.com, sub.seeyouyima.com, users.seeyouyima.com, config-service.seeyouyima.com

