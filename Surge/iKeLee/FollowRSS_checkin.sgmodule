#!arguments=token:"",cookie:"",cron:"0 1 * * *"
#!arguments-desc=token: csrfToken\n这里需要输入csrfToken的值\n\ncookie: Cookie\n这里需要输入Cookie的值\n\ncron: 定时参数\n这里需要输入符合CRON表达式的参数

[Script]
Follow每日签到 = type=cron, cronexp="{{{cron}}}", script-path=https://kelee.one/Resource/JavaScript/FollowRSS/FollowRSS_checkin.js, timeout=120, argument=token="{{{token}}}"&cookie="{{{cookie}}}"

[MITM]
hostname = %APPEND% api.follow.is

