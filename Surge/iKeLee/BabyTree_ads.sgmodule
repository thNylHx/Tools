#!name=宝宝树孕育去广告
#!desc=过滤宝宝树孕育广告
#!author=RuCu6[https://github.com/RuCu6]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BabyTree.png
#!openUrl=https://apps.apple.com/app/id523063187
#!category=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Rule]
URL-REGEX,"^http:\/\/go\.babytree\.com\/go_pregnancy\/api\/(index_activity\/get_app_index_activity|sign\/sign_h_5)\?",REJECT-TINYGIF
URL-REGEX,"^http:\/\/go\.babytree\.com\/go_search\/api\/mobile_search_new\/get_multi_search_default_keywords\?",REJECT-TINYGIF
URL-REGEX,"^http:\/\/m\.meitun\.com\/newapi\/router\/topic\/hometptf\/feedRecommend",REJECT-TINYGIF
URL-REGEX,"^http:\/\/pic08\.babytreeimg\.com\/knowledge\/2022\/0923\/\w+",REJECT
URL-REGEX,"^http:\/\/plough\.babytree\.com\/plough\.do",REJECT-TINYGIF

[Script]
调整整体配置 = type=http-response, pattern=(?i)^http:\/\/api\.babytree\.com\/bafconfigcenter_intf\/config\/get\?, script-path=https://kelee.one/Resource/JavaScript/BabyTree/BabyTree_remove_ads.js, requires-body=true

移除各页面推广 = type=http-response, pattern=(?i)^http:\/\/go\.babytree\.com\/go_pregnancy\/api\/(app_index\/get_app_tab|cms_column\/get_column_list|feeds\/get_index_feeds_list|user\/get_user_info)\?, script-path=https://kelee.one/Resource/JavaScript/BabyTree/BabyTree_remove_ads.js, requires-body=true

移除搜索列表推广 = type=http-response, pattern=(?i)^http:\/\/go\.babytree\.com\/go_search\/api\/mobile_search_new\/search_index, script-path=https://kelee.one/Resource/JavaScript/BabyTree/BabyTree_remove_ads.js, requires-body=true

[MITM]
hostname = %APPEND% api.babytree.com, go.babytree.com

