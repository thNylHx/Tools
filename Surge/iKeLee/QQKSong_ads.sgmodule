(?i)^https:\/\/wnsaviator\.kg\.qq\.com\/wnsaviator\/api\/v1\/transMerge\?(?:[^#?&]+&)*_webcgikey=get_activity_entry$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
