#!name=新浪财经去广告
#!desc=移除开屏广告、弹窗广告、横幅广告、信息流广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/SinaStock.png
#!openUrl=https://apps.apple.com/app/id430165157
#!category=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Body Rewrite]
http-response-jq (?i)^https:\/\/news\.cj\.sina\.cn\/app\/v1\/news724\/list\? 'delpaths([["result","data","ad"]])'
http-response-jq (?i)^https:\/\/app\.cj\.sina\.com\.cn\/apps\/api\/user\/center\? '.result.data |= with_entries(select(.key == "button" or .key == "account" or .key == "balance"))'
http-response-jq (?i)^https:\/\/news\.cj\.sina\.cn\/toutiao\/content\? 'del(.result.data[]?.ad, .result.data[]?.report)'
http-response-jq (?i)^https:\/\/app\.cj\.sina\.com\.cn\/api\/deal\/index\? 'delpaths([["data","banner"]])'
http-response-jq (?i)^https:\/\/app\.cj\.sina\.com\.cn\/clientSetting\/api\/start\/init\? 'delpaths([["result","data","search_ad"]])'
http-response-jq (?i)^https:\/\/app\.cj\.sina\.com\.cn\/clientSetting\/api\/start\/init\? 'delpaths([["result","data","center_ads"]])'
http-response-jq (?i)^https:\/\/app\.cj\.sina\.com\.cn\/clientSetting\/api\/start\/init\? 'delpaths([["result","data","banner_new_tagid"]])'
http-response-jq (?i)^https:\/\/app\.cj\.sina\.com\.cn\/clientSetting\/api\/start\/init\? 'delpaths([["result","data","ad_hasAddScreenParam"]])'
http-response-jq (?i)^https:\/\/app\.cj\.sina\.com\.cn\/clientSetting\/api\/start\/init\? 'delpaths([["result","data","us_trade"]])'
http-response-jq (?i)^https:\/\/app\.cj\.sina\.com\.cn\/clientSetting\/api\/start\/init\? 'delpaths([["result","data","open_account"]])'
http-response-jq (?i)^https:\/\/app\.cj\.sina\.com\.cn\/clientSetting\/api\/start\/init\? 'delpaths([["result","data","us_hq_trade"]])'
http-response-jq (?i)^https:\/\/(newscj\.xincai\.com|news\.cj\.sina\.cn)\/app\/v1\/feed\? '.data.feed.data |= map(select((.author // "") != ""))'

[Map Local]
(?i)^https:\/\/news\.cj\.sina\.cn\/search\/tips\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/search\.cj\.sina\.cn\/stock\/get_index_new\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/news\.cj\.sina\.cn\/search\/tips\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/recommend\.cj\.sina\.cn\/app\/v2\/search\/discovery$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/quotes\.sina\.com\.cn\/cn\/api\/openapi\.php\/PriceChangeService\.getSearchList\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% app.cj.sina.com.cn, news.cj.sina.cn, search.cj.sina.cn, recommend.cj.sina.cn, quotes.sina.com.cn, newscj.xincai.com

