[Script]
入口落地查询 = type=generic, script-path=https://kelee.one/Resource/JavaScript/Node_detection_tool/NetworkEntryAndExitQueries.js, timeout=10

地理位置查询 = type=generic, script-path=https://kelee.one/Resource/JavaScript/Node_detection_tool/LocationDetection.js, timeout=10

节点解锁查询 = type=generic, script-path=https://kelee.one/Resource/JavaScript/Node_detection_tool/NodeUnlockDetection.js, timeout=20

