#!name=QQ链接解锁
#!desc=解除QQ内访问非白名单之外的地址提示停止访问该页面的限制，并移除跟踪参数，使用前需要清除QQ的缓存数据。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/QQ.png
#!openUrl=https://apps.apple.com/app/id444934666
#!category=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[URL Rewrite]
(?i)(^https:\/\/c\.pc\.qq\.com\/middlem\.html\?(?:[^#?&]+&)*pfurl=)(http.*)(&pfuin=.*) $2 307
(?i)(^https:\/\/c\.pc\.qq\.com\/middlect\.html\?(?:[^#?&]+&)*pfuin=.*&pfurl=)(http.*)(&gjsublevel=.*) $2 307
(?i)(^https:\/\/c\.pc\.qq\.com\/middlect\.html\?(?:[^#?&]+&)*iscontinue=.*pfurl=)(http.*)(&pfuin=.*) $2 307
(?i)(^https:\/\/pingtas\.qq\.com\/webview\/pingd\?(?:[^#?&]+&)*dm=c\.pc\.qq\.com&pvi=\d+&si=s\d+&url=\/middlem\.html\?(?:[^#?&]+&)*pfurl%3d)(http.*)(%26pfuin%3d.*%26pfuin%3d.*) $2 307
(?i)(^https:\/\/cgi\.connect\.qq\.com\/qqconnectopen\/get_urlinfoForQQV2\?(?:[^#?&]+&)*url=)(http.*) $2 307
(?i)(^https:\/\/c\.pc\.qq\.com\/index\.html\?(?:[^#?&]+&)*pfurl=)(http.*)(&pfuin=.*) $2 307
(?i)(^https:\/\/c\.pc\.qq\.com\/ios\.html\?(?:[^#?&]+&)*url=)(http.*)(&level=.*) $2 307
(?i)(^https:\/\/pingtas\.qq\.com\/webview\/pingd\?(?:[^#?&]+&)*dm=c\.pc\.qq\.com&pvi=\d+&si=s\d+&url=\/ios\.html\?(?:[^#?&]+&)*url%3d)(http.*)(%26level.*%26level.*) $2 307

[MITM]
hostname = %APPEND% pingtas.qq.com, c.pc.qq.com, cgi.connect.qq.com

